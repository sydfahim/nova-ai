{
  "version": 1,
  "sdk_version": "3.0.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://lqsolzjqxfeqhfsfgork.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "nova-your-ai-companion",
      "version": "0.1.0",
      "title": "Nova: Your AI Companion"
    },
    "tools": [
      {
        "name": "list_conversations",
        "title": "List Nova conversations",
        "description": "List the signed-in user's Nova conversations, most recently updated first. Returns id, title and timestamps.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Max conversations (default 20)."
            }
          },
          "required": [
            "limit"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_conversations",
        "title": "Search Nova conversations",
        "description": "Search the signed-in user's Nova conversations by title text. Returns matching conversation ids and titles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Text to look for in conversation titles."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                {
                  "type": "null"
                }
              ],
              "description": "Max results (default 10)."
            }
          },
          "required": [
            "query",
            "limit"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "read_conversation",
        "title": "Read a Nova conversation",
        "description": "Read the full message transcript of one of the signed-in user's Nova conversations by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "conversationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Conversation id from list_conversations."
            }
          },
          "required": [
            "conversationId"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
